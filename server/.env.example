# Copy to .env and adjust for your environment.
NODE_ENV=development
# Port de l'API (9000 par défaut ; 4000 est souvent déjà pris en local).
PORT=9000

# PostgreSQL
# DATABASE_URL: superuser/owner role, used only by migrate.js and seed.js.
DATABASE_URL=postgres://mems:mems@localhost:5432/mems2_tpm
# APP_DATABASE_URL: dedicated restricted role created by migration 012
# (NOSUPERUSER NOBYPASSRLS) — used by the API and worker at runtime so
# Row-Level Security is actually enforced. Dedicated to MEMS 2.0; it never
# touches a mems_app role from another system on the same server. Falls back
# to DATABASE_URL if unset, but that defeats RLS, so always set it.
APP_DATABASE_URL=postgres://mems2_app:mems2_app_change_me@localhost:5432/mems2_tpm

# Connecteurs « lien de données » (Tableau WDC / open-data Ona-MoDA, API Kobo,
# exports web). Par sécurité (anti-SSRF), le serveur refuse les adresses du
# réseau privé. Si vos sources sont sur le réseau interne (ex. MoDA via
# l'intranet/VPN), listez ici les hôtes autorisés — seuls ceux-ci seront alors
# acceptés (sous-domaines compris). Laisser vide = Internet public uniquement.
DATA_SOURCE_ALLOWED_HOSTS=
# Exemple : DATA_SOURCE_ALLOWED_HOSTS=moda.wfp.org,kf.kobotoolbox.org,api.ona.io

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Worker
WORKER_CONCURRENCY=4
